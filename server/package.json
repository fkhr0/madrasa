{
  "name": "school-api",
  "version": "0.1.0",
  "private": true,
  "description": "API server for the school app (Express + PostgreSQL)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "dev": "node --watch src/server.js",
    "db:reset": "node src/db/reset.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:pg": "node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@electric-sql/pglite": "^0.5.15",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.2",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "cron-parser": "^5.10.4",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.2",
    "sharp": "^0.35.5",
    "web-push": "^4.0.0",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "s3rver": "^3.7.1",
    "supertest": "^7.3.1"
  }
}
