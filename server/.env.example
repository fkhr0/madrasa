# Copy this file to .env and change what you need.

# Empty = a local PostgreSQL that runs inside Node (PGlite), stored in .data/
# Online (Neon, Supabase…): postgres://user:password@host/db?sslmode=require
DATABASE_URL=

PORT=3000

# Long random strings. Anyone who knows them can sign in as anyone.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Demo data (all demo accounts use this password). Set to false in production.
SEED_DEMO_DATA=true
DEMO_PASSWORD=demo1234

# Maps (OpenStreetMap). Empty = the free public servers. OSRM_URL=off draws
# bus lines as straight lines (no internet needed).
OSRM_URL=
NOMINATIM_URL=

# Web Push keys. Empty = the server makes a pair once in .data/push-keys.json.
# Online, set both so phones stay subscribed when the server moves.
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Background jobs (BullMQ + Redis). Empty = jobs run on a small timer inside
# the server (no Redis needed). Redis Cloud free: redis://default:PASSWORD@host:port
REDIS_URL=
# false = the API only queues jobs and "node src/worker.js" runs them
# (online, as a separate service). true = this server runs them too.
RUN_WORKER=true
TIME_ZONE=Asia/Baghdad

# ── Security ──
# production = HTTPS-only header, no demo data, and the server refuses to
# start with weak secrets or without DATABASE_URL.
NODE_ENV=development
# Other websites allowed to call the API (comma-separated), e.g. https://app.school.iq
# The web app served by this same server never needs one.
CORS_ORIGINS=
# Proxies in front (Caddy, Cloudflare) so limits see the real address.
# 0 = reached directly; online behind Caddy = 1; Cloudflare + Caddy = 2.
TRUST_PROXY=0
# true = the browser only reports what the page security rules would block.
CSP_REPORT_ONLY=false
# Password hashing work (12 ≈ a quarter second per sign-in).
BCRYPT_COST=12

# `npm run test:pg`: the tests on a real PostgreSQL. The database is wiped
# by every run, so its name must contain "test" (it is made if missing).
TEST_DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/school_test

# Nightly backups (2:00). PostgreSQL is backed up with pg_dump: in PATH, or
# its full path, e.g. C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
BACKUPS_DIR=.data/backups
PG_DUMP=pg_dump

# ── Several servers ──
# Everything that must be shared between servers goes through REDIS_URL
# (live updates, limits, sign-in locks, caches, jobs) and the database.
# With more than one server: REDIS_URL is required, VAPID keys must be set
# (the same on all), and uploaded files must use a bucket:
# local = UPLOADS_DIR on this server; s3 = Cloudflare R2 / MinIO / AWS S3.
STORAGE=local
UPLOADS_DIR=.data/uploads
# Cloudflare R2: https://<account id>.r2.cloudflarestorage.com, region auto.
# MinIO: http://minio:9000 and S3_PATH_STYLE=true.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE=false
# Database connections per server (Neon free allows ~100 in all).
DB_POOL_SIZE=10

# ── Android notifications (Firebase Cloud Messaging) ──
# Firebase console → Project settings → Service accounts → Generate new
# private key. Keep the file secret (it can send notifications as the app).
FIREBASE_SERVICE_ACCOUNT_FILE=

# Largest uploads in MB: videos, and every other kind of file.
MAX_VIDEO_MB=50
MAX_UPLOAD_MB=10

# ── Public pages (Google Play links to /privacy and /delete-account) ──
OPERATOR_NAME=the Madrasa team
CONTACT_EMAIL=privacy@madrasa.iq
POLICY_UPDATED=2026-11-09
