# The server's settings. Copy to .env (never in git), fill in, then
# bash scripts/configure.sh. Generate secrets with:
#   openssl rand -hex 48

# ── Where ──
DOMAIN=madrasa-school.duckdns.org
CERT_EMAIL=you@example.com
# Set by scripts/deploy.sh (GitHub Actions); the first time, the latest image.
IMAGE=ghcr.io/owner/madrasa-api:latest
# Grafana over Tailscale at http://<this IP>:3001: the server's address from
# `tailscale ip -4` (100.x.y.z). Empty = only on the server itself.
TAILSCALE_IP=

# ── Database (Neon: the "direct" connection, not "-pooler") ──
DATABASE_URL=postgres://user:password@ep-xxx.eu-central-1.aws.neon.tech/madrasa?sslmode=require
DB_POOL_SIZE=10

# ── Secrets ──
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
GRAFANA_PASSWORD=

# ── App ──
SEED_DEMO_DATA=false
# "Try the app" on the sign-in page: a demo school (Arabic), no password,
# made again every night at 03:00. Real schools are never touched.
DEMO_MODE=true
DEMO_LANGUAGE=ar
DEFAULT_LANGUAGE=ar
TIME_ZONE=Asia/Baghdad
OPERATOR_NAME=
CONTACT_EMAIL=
POLICY_UPDATED=2026-11-09
CORS_ORIGINS=
MAX_VIDEO_MB=50
MAX_UPLOAD_MB=10

# Firebase (Android notifications): the service account file, copied to
# deploy/secrets/firebase.json on the server.
FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase.json

# ── Off-site backups (S3) ──
# AWS: the bucket from "tofu output backup_bucket"; no keys (the server's role).
# Oracle / R2: also the endpoint, keys and BACKUP_S3_PATH_STYLE=true.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=eu-central-1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PATH_STYLE=false

# ── Alerts to Telegram (optional): talk to @BotFather for a token,
# then send your bot a message and read chat_id at
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
