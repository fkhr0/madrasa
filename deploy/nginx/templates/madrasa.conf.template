# The site at https://${DOMAIN}. Nginx's image turns this file into
# /etc/nginx/conf.d/madrasa.conf, filling in ${DOMAIN} from the environment.

# ── http, every name on this server: the certificate check, else https ──
server {
  listen 80 default_server;
  listen [::]:80 default_server;
  server_name _;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }
  location / {
    return 301 https://$host$request_uri;
  }
}

# ── https ──
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;

  # Security headers (CSP and the rest) come from the app itself.

  limit_conn conn_per_ip 50;

  # Numbers for Prometheus only (inside the server), never from outside.
  location = /metrics {
    return 404;
  }

  # Live updates: a long-lived connection.
  location /ws {
    proxy_pass http://api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  # Sign-in: slower limit (guessing passwords).
  location = /auth/login {
    limit_req zone=sign_in burst=5 nodelay;
    proxy_pass http://api;
    include /etc/nginx/templates/proxy_headers.inc;
  }

  # Uploads: big bodies, more time, streamed to the app.
  location = /files {
    limit_req zone=per_ip burst=10 nodelay;
    proxy_pass http://api;
    proxy_request_buffering off;
    proxy_read_timeout 180s;
    proxy_send_timeout 180s;
    include /etc/nginx/templates/proxy_headers.inc;
  }

  location / {
    limit_req zone=per_ip burst=60 nodelay;
    proxy_pass http://api;
    include /etc/nginx/templates/proxy_headers.inc;
  }
}
